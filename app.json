{
  "expo": {
    "name": "Shopper",
    "slug": "shopper",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shopper",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.julianaekaputri.shopper"
    },
    "android": {
      "package": "com.julianaekaputri.shopper",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Shopper uses your photo library so you can attach a cover photo when opening a jastip event."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Shopper uses your photo library so you can save a downloaded receipt photo.",
          "savePhotosPermission": "Shopper saves receipt photos to your photo library when you download them.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
